# r analysis
library(lme4)
library(lmerTest)
library(sjPlot)
library(sjlabelled)
library(sjmisc)
library(ggplot2)
library(dplyr)
data <-read.csv("../results/transfer_analysis_R.csv")
data <-read.csv("../results/transfer_and_lin_features.csv")
colnames(data)
# standardizing predictors
data_standardized <- data
predictors_to_standardize <- c("syn", "geo", "pho", "gen", "inv", "feat")
for(predictor in predictors_to_standardize) {
data_standardized[[predictor]] <- scale(data[[predictor]])
}
# random intercepts
m0 <- lmer(transfer ~ syn + geo + pho + gen + inv + feat + (1|model) + (1|Lang1) + (1|Lang2), data = data_standardized)
summary(m0)
# random intercepts
m0 <- lmer(transfer ~ syn + geo + pho + gen + inv + feat + (1|model), data = data_standardized)
summary(m0)
