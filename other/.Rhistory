predictors <- c("syn", "geo", "pho", "gen", "inv", "feat")
# fit a model for each predictor
fit_model <- function(predictor) {
formula <- as.formula(paste(predictor, "ppx_1 + ppx_2 + (1|model) + (1|Language)", sep = " + "))
lmer(formula, data = data_expanded)
}
models <- lapply(predictors, fit_model)
predictors <- c("syn", "geo", "pho", "gen", "inv", "feat")
# Define a function to fit a model for each predictor
fit_model <- function(predictor) {
# Ensure the formula is correctly constructed and converted
formula_str <- paste(predictor, "+ ppx_1 + ppx_2 + (1|model) + (1|Language)", sep = " ")
formula <- as.formula(formula_str)
lmer(formula, data = data_expanded)
}
# Use lapply to iterate over predictors and fit models
