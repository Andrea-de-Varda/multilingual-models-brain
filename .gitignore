# ---------------------------------------------------------------------------
# Large or regenerable data that is not distributed through this repository
# (see README, "What is not included"). Embeddings for one model are on OSF.
# ---------------------------------------------------------------------------

# model embeddings (~200 GB in total; regenerate with the get_*embeddings*.py scripts)
**/embeddings/**
**/embeddings_*/**

# raw regression weights / per-fold dumps
**/coefficients/**

# audio stimuli (available on OSF)
sound_data/**
confirmatory/sound_data/**
*.wav

# source fMRI datasets that must be obtained from the original studies
additional_analyses/pereira/Pereira.parquet.gzip
additional_analyses/NaturalStories/NaturalStories_TimeSeries_20220615.csv
additional_analyses/**/TimeSeries_*.csv

# analyses not reported in the paper (kept locally only)
additional_analyses/MECO/
additional_analyses/residualize_info/glasgow_norms.csv

# ---------------------------------------------------------------------------
# Local scratch, archives, logs and editor/tool state
# ---------------------------------------------------------------------------
**/old/**
other/other/
**/*.zip
logs/
*.out
*.err
__pycache__/
*.pyc
.Rhistory
*(copy)*
plt
sns
mpl
.claude/
paper.docx
paper.txt
response_to_reviews.txt
